// use prisma-8

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       Int
  isActive     Boolean   @default(true)
  lastLoginAt  TimestamptzString?
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  role           Role                 @relation(fields: [roleId], references: [id])
  uploadedDocs   Document[]           @relation("UploadedDocuments")
  documentAccess DocumentPermission[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String?

  users          User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Document {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  filePath    String
  mimeType    String
  fileSize    Int
  uploadedBy  Int
  isActive    Boolean   @default(true)
  createdAt   TimestamptzString @default(now())
  updatedAt   TimestamptzString @default(now())

  uploader    User                 @relation("UploadedDocuments", fields: [uploadedBy], references: [id])
  permissions DocumentPermission[]

  @@index([uploadedBy])
  @@index([isActive])
  @@map("documents")
}

model DocumentPermission {
  documentId Int
  userId     Int
  canView    Boolean @default(true)
  canDownload Boolean @default(false)
  grantedAt  TimestamptzString @default(now())

  document Document @relation(fields: [documentId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@id([documentId, userId])
  @@index([userId])
  @@map("document_permissions")
}

model AuditLog {
  id           Int       @id @default(autoincrement())
  userId       Int?
  action       String
  resourceType String?
  resourceId   Int?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  createdAt    TimestamptzString @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt TimestamptzString
  revokedAt TimestamptzString?
  createdAt TimestamptzString @default(now())
  ipAddress String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}