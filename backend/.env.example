# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5433/securevault"

FRONTEND_URL="http://localhost:5173"

NODE_ENV="development"

ACCESS_TOKEN_SECRET="YOUR_RANDOM_SECRET"

JWT_ISSUER="securevault-api"

JWT_AUDIENCE="securevault-client"

CSRF_SECRET="YOUR_RANDOM_CSRF_SECRET"